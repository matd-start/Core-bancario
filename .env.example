# Copia este archivo como .env y ajusta los valores. .env no se sube al repositorio.
POSTGRES_DB=core_bancario
POSTGRES_USER=core_bancario
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5432

# Keycloak (docker compose up -d lo levanta junto con PostgreSQL). La consola de administración queda en
# http://localhost:${KEYCLOAK_PORT}. Pon aquí tu propio usuario y clave: no uses valores de ejemplo.
KEYCLOAK_PORT=8080
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Secreto de la cuenta de servicio con la que la API gestiona accesos (cliente core-bancario-api-admin del realm
# clientes). Genera uno largo y aleatorio. El MISMO valor va en los user-secrets de la API
# (Keycloak:Administracion:ClientSecret) o en la variable Keycloak__Administracion__ClientSecret.
KC_CLIENTES_API_SECRET=

# La cadena de conexión de la API NO va aquí ni en el repositorio: defínela con user-secrets
# (ConnectionStrings:CoreBancario) o con la variable de entorno ConnectionStrings__CoreBancario.
# Ver README, sección "Cadena de conexión de la API".
